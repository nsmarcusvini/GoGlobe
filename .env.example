# Copy to .env.local and fill in. Never commit real values.
# Secrets (no NEXT_PUBLIC_ prefix) are only read on the server.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: local values come from `npm run db:start` (or `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_6MONTHS=
# Pix on the one-off 6-month pass (enable Pix on the Stripe account first).
STRIPE_PIX_ENABLED=false
# Prices shown on /precos (the amount charged is the Stripe Price above).
PRO_PRICE_MONTHLY_BRL=29
PRO_PRICE_PASS_BRL=129

# Feature flags
PAYMENTS_ENABLED=false
AI_ENABLED=false

# AI assistant (Phase 7). ANTHROPIC_MODEL defaults to claude-opus-5-5 and the
# quota to 100 messages per month. Embeddings use Voyage AI (voyage-3.5) when
# VOYAGE_API_KEY is set; without it, a lexical offline provider is used.
# AI_MOCK=true answers with canned text instead of calling Anthropic (e2e only).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_MONTHLY_MESSAGE_QUOTA=
VOYAGE_API_KEY=
VOYAGE_MODEL=
AI_MOCK=false

# Analytics (Phase 6)
NEXT_PUBLIC_POSTHOG_KEY=

# Auth: show the Google button once the provider is configured in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

STRIPE_PIX_ENABLED=true
