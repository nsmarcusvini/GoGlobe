# Copy to .env.local and fill in. Never commit real values.
# Secrets (no NEXT_PUBLIC_ prefix) are only read on the server.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: local values come from `npm run db:start` (or `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_6MONTHS=

# Feature flags
PAYMENTS_ENABLED=false
AI_ENABLED=false

# AI assistant (Phase 7)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_MONTHLY_MESSAGE_QUOTA=

# Analytics (Phase 6)
NEXT_PUBLIC_POSTHOG_KEY=
